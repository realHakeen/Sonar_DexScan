# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Optional: webhook mode (leave empty for long polling)
TELEGRAM_WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_PATH=/tg/webhook
PORT=3000

# ---- CoinMarketCap ----
CMC_API_KEY=your-cmc-pro-api-key
CMC_BASE_URL=https://pro-api.coinmarketcap.com
# 走代理时单次请求常见 2–3s，峰值更高；直连可以调回 6000
CMC_TIMEOUT_MS=10000
CMC_MAX_RETRIES=1

# ---- Cache TTLs (ms) ----
CACHE_TTL_SEARCH_MS=30000
CACHE_TTL_QUOTE_MS=15000
CACHE_TTL_HOLDERS_MS=120000
CACHE_TTL_SECURITY_MS=600000
CACHE_TTL_META_MS=3600000

# ---- Rate limits ----
RATE_LIMIT_PRIVATE_PER_MIN=20
RATE_LIMIT_GROUP_PER_MIN=6
RATE_LIMIT_GROUP_COOLDOWN_MS=8000

# ---- Risk thresholds ----
RISK_TOP10_PCT=60
RISK_TOP50_PCT=85
RISK_SINGLE_LP_PCT=70
RISK_MIN_LIQUIDITY_USD=5000
RISK_MAX_TAX_PCT=10

# ---- Charts ----
# K 线预览图的公网地址（无尾部斜杠）。Railway 生成域名后会自动注入 RAILWAY_PUBLIC_DOMAIN，可留空。
# 本地开发留空 = 不出图。
PUBLIC_BASE_URL=
CACHE_TTL_CHART_MS=300000
CACHE_TTL_DERIVATIVES_MS=60000

# ---- Misc ----
LOG_LEVEL=info
# Proxy: HTTP_PROXY / HTTPS_PROXY / NO_PROXY from the environment are honoured automatically.
